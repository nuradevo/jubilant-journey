## 7. Тесты, которые нужно написать

Создай файл:

```text
backend/tests/test_items_api.py
```

Минимально нужны 4 теста:

1. `GET /api/v1/items` возвращает список и status `200`;
2. `GET /api/v1/items/1` возвращает один item и status `200`;
3. `GET /api/v1/items/999` возвращает status `404`;
4. `POST /api/v1/items` создаёт item и возвращает status `201`.

Примерный каркас:

```python
from fastapi.testclient import TestClient

from backend.src.bootstrap.app_factory import create_app


def test_list_items_returns_seed_items() -> None:
    client = TestClient(create_app())

    response = client.get("/api/v1/items")

    assert response.status_code == 200
    data = response.json()
    assert isinstance(data, list)
    assert len(data) >= 2
    assert data[0]["id"] == 1


def test_get_item_by_id_returns_item() -> None:
    client = TestClient(create_app())

    response = client.get("/api/v1/items/1")

    assert response.status_code == 200
    assert response.json()["id"] == 1


def test_get_unknown_item_returns_404() -> None:
    client = TestClient(create_app())

    response = client.get("/api/v1/items/999")

    assert response.status_code == 404
    assert response.json() == {"detail": "Item not found"}


def test_create_item_returns_created_item() -> None:
    client = TestClient(create_app())

    response = client.post(
        "/api/v1/items",
        json={
            "title": "Add API endpoint",
            "description": "Implement POST /api/v1/items",
        },
    )

    assert response.status_code == 201
    assert response.json()["title"] == "Add API endpoint"
    assert response.json()["is_done"] is False
```

